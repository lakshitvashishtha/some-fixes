# ==============================================================================
# Codefiesta 5.0 - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to public version control.
# ==============================================================================

# Server / API Origin (leave empty for same-origin relative URLs in production)
BACKEND_URL=
PORT=3000

# Zoho / SMTP Mail Dispatcher Configuration
# Used for automated OTP login codes and payment verification confirmation emails
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Codefiesta 5.0 Support" <support@protechy.in>

# Cloudinary asset storage (optional)
CLOUDINARY_URL=
